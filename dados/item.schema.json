{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otimizapro.com/trabalhista-fiscal/dados/item.schema.json",
  "title": "Item da Base Nacional de Dados Trabalhistas e Fiscais da Otimiza.pro",
  "description": "Um item (por exemplo, a tabela do INSS) com todas as suas versões. Cada versão tem a vigência, os valores, as normas que os fixam, as fontes oficiais lidas, a data de conferência e o estado da revisão.",
  "type": "object",
  "required": [
    "id",
    "base",
    "tipo",
    "abrangencia",
    "nome",
    "descricao",
    "versoes"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Identificador estável; também é o fim da URL do item."
    },
    "base": {
      "enum": [
        "tabelas-da-folha"
      ]
    },
    "tipo": {
      "enum": [
        "valor",
        "faixas-progressivas",
        "faixas-com-deducao",
        "reducao-irrf",
        "salario-familia",
        "fgts",
        "seguro-desemprego",
        "piso-estadual"
      ]
    },
    "abrangencia": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "tipo"
          ],
          "additionalProperties": false,
          "properties": {
            "tipo": {
              "const": "nacional"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "tipo",
            "uf"
          ],
          "additionalProperties": false,
          "properties": {
            "tipo": {
              "const": "estadual"
            },
            "uf": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          }
        }
      ]
    },
    "nome": {
      "type": "string",
      "minLength": 3
    },
    "descricao": {
      "type": "string",
      "minLength": 10
    },
    "relacionados": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "versoes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/versao"
      }
    }
  },
  "$defs": {
    "data": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "versao": {
      "type": "object",
      "required": [
        "vigencia",
        "valores",
        "normas",
        "fontes",
        "conferido_em",
        "revisao"
      ],
      "additionalProperties": false,
      "properties": {
        "vigencia": {
          "type": "object",
          "required": [
            "inicio",
            "fim"
          ],
          "additionalProperties": false,
          "properties": {
            "inicio": {
              "$ref": "#/$defs/data"
            },
            "fim": {
              "oneOf": [
                {
                  "$ref": "#/$defs/data"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "valores": {
          "type": "object",
          "description": "A forma depende do tipo do item; ver o README do repositório público."
        },
        "normas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "tipo",
              "numero"
            ],
            "additionalProperties": false,
            "description": "A data e o endereço do ato ficam de fora quando não foram lidos no próprio ato; o valor, nesse caso, se prova pelas fontes.",
            "properties": {
              "tipo": {
                "type": "string"
              },
              "numero": {
                "type": "string"
              },
              "data": {
                "$ref": "#/$defs/data"
              },
              "dispositivo": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        },
        "fontes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "url",
              "nivel_de_prova",
              "trecho",
              "lido_em"
            ],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "nivel_de_prova": {
                "enum": [
                  "A",
                  "B"
                ],
                "description": "A: o texto do próprio ato. B: página oficial que reproduz o ato."
              },
              "trecho": {
                "type": "string",
                "minLength": 10,
                "description": "Citação literal curta que prova o valor."
              },
              "lido_em": {
                "$ref": "#/$defs/data"
              }
            }
          }
        },
        "conferido_em": {
          "$ref": "#/$defs/data"
        },
        "nota": {
          "type": "string",
          "description": "Observação pública sobre a versão (por exemplo, como a data de início foi obtida)."
        },
        "revisao": {
          "type": "object",
          "required": [
            "estado",
            "por",
            "em"
          ],
          "additionalProperties": false,
          "properties": {
            "estado": {
              "enum": [
                "conferido_nas_fontes",
                "revisado"
              ]
            },
            "por": {
              "type": [
                "string",
                "null"
              ]
            },
            "em": {
              "oneOf": [
                {
                  "$ref": "#/$defs/data"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    }
  }
}
